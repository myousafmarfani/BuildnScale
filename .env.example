# ============================================================
# buildnscale.dev — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth.js v4 ---
# Generate with: openssl rand -base64 32
# Used by NextAuth and JWT checks in the dashboard proxy
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Your app's base URL (change to production URL when deploying)
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# --- Cron / Downtime Monitor ---
# A shared secret to authorize cron job requests
CRON_SECRET="replace-with-a-random-cron-secret"

# --- Buttondown (Newsletter) ---
# Get your API key at https://buttondown.com/settings
BUTTONDOWN_API_KEY="your-buttondown-api-key"

# --- Optional ---
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- AI benchmark imports (optional; bundled historical results work without these) ---
# Apply supabase/migrations/20261026_benchmark_snapshots.sql before running imports.
# Keep API keys server-side. API access alone does not establish public-display rights.
AA_API_KEY=""
AA_PUBLIC_DISPLAY_ENABLED="false"
# Store your agreement/permission reference here, never a secret or personal information.
AA_PERMISSION_REFERENCE=""
